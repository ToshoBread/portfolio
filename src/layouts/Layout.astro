---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { skillGroups } from '../data/skills';

const pageTitle = "Zion Nathan Dionisio | IT Student"
const pageDescription = 'IT Student Portfolio | Writing code for anything that runs'

const shareImage = '/og-image.png'
const shareContent = new URL(shareImage, Astro.url.href)

const siteURL = Astro.site?.href ?? "https://zndionisio.pages.dev";
const canonicalURL = new URL(Astro.url.pathname, siteURL);

const technicalSkills = skillGroups
  .filter((group) => group.title !== "Communication")
  .flatMap((g) => g.skills.map((s) => s.name));

const languages = skillGroups
  .find((group) => group.title === "Communication")
  ?.skills.map((skill) => skill.bcp47).filter(Boolean) ?? [];

const jsonLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Zion Nathan Dionisio",
  "url": siteURL,
  "jobTitle": "IT Student",
  "description": pageDescription,
  "image": shareContent.href,
  "sameAs": [
    "https://github.com/ToshoBread",
    "https://www.linkedin.com/in/zndionisio/"
  ],
  "knowsAbout": ["Web Development", "Software Engineering", "Information Technology"],
  "skills": technicalSkills,
  "knowsLanguage": languages,
  "email": "zndionisio.2121@gmail.com"
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={shareContent} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareContent} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={jsonLD} />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen antialiased font-sans">
    <Navigation />
    <main class="pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>
