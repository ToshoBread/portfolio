---
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
---

<section id="contact" class="fade-in min-h-screen px-8 md:px-16 lg:px-24 flex flex-col justify-center">
  <div class="text-center">
    <div class="inline-block px-3 py-1 bg-rosepine-pine/20 rounded-full mb-6">
      <span class="text-rosepine-pine text-sm font-mono">let's collaborate</span>
    </div>
    <h2 class="text-4xl font-bold text-rosepine-light mb-6">
      Got something interesting?
    </h2>
    <p class="text-rosepine-subtle mb-10 max-w-lg mx-auto font-body">
      I'm up for a good conversation about code, projects,
      or why neovim is better than emacs (it just is).
    </p>
    <a
      href="mailto:zndionisio.2121@gmail.com"
      class="inline-flex items-center gap-2 bg-rosepine-rose text-rosepine-base px-8 py-4 rounded-xl font-medium hover:opacity-90 transition-opacity text-lg"
    >
      <span>email me</span>
      <span>→</span>
    </a>
    <div class="mt-6 flex justify-center gap-4">
      <a href="https://github.com/ToshoBread" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-rosepine-surface text-rosepine-light px-6 py-3 rounded-xl font-medium hover:bg-rosepine-overlay transition-colors text-lg">
        <GitHubIcon />
        <span>github</span>
      </a>
      <a href="https://www.linkedin.com/in/zndionisio/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-rosepine-surface text-rosepine-light px-6 py-3 rounded-xl font-medium hover:bg-rosepine-overlay transition-colors text-lg">
        <LinkedInIcon />
        <span>linkedin</span>
      </a>
    </div>
  </div>
</section>
