---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section id="work" class="fade-in py-32 px-8 md:px-16 lg:px-24">
  <div class="max-w-5xl">
    <div class="flex items-baseline gap-2 mb-4 flex-wrap">
      <h2 class="text-4xl font-bold text-rosepine-foreground">projects</h2>
            <span class="text-rosepine-muted/40 font-mono text-xs whitespace-nowrap">(that actually work)</span>
    </div>

    <div class="grid gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </div>
</section>
