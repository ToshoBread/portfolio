---
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
---

<section class="fade-in min-h-[min(100dvh,100vh)] flex items-start pt-24 md:pt-32 px-8 md:px-16 lg:px-24 relative overflow-hidden">
    <div class="absolute top-20 right-16 text-rosepine-overlay font-bold leading-none select-none pointer-events-none whitespace-nowrap max-md:[writing-mode:vertical-rl] font-jp" style="font-size: clamp(80px, 15vw, 200px);">
        ザイオン
    </div>
    <div class="max-w-3xl relative z-10">
        <div class="flex items-baseline gap-2 mb-6">
            <div class="inline-block px-3 py-1 bg-rosepine-rose/20 rounded-full">
                <span class="text-rosepine-rose text-sm font-mono">hello world</span>
            </div>
            <span class="text-rosepine-subtle text-xs font-mono">(wow how cliché)</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-bold text-rosepine-light mb-4">
            Zion Nathan Dionisio
        </h1>
        <p class="text-2xl text-rosepine-iris mb-8">debugger by day, still debugging by night</p>
        <p class="text-lg text-rosepine-subtle leading-relaxed mb-12 max-w-xl font-body">
            Information Technology student at
            <a href="https://neu.edu.ph" target="_blank" rel="noopener noreferrer" class="font-bold hover:text-rosepine-iris">New Era University</a>.
            I live in the terminal and write code for anything that runs.
        </p>
        <div class="flex items-center gap-4 flex-wrap">
            <div class="flex gap-2 md:gap-4 items-center">
                <a href="#work" class="bg-rosepine-pine text-rosepine-light px-4 md:px-6 py-2 md:py-3 rounded-xl text-sm md:text-base font-medium hover:opacity-90 transition-opacity whitespace-nowrap">
                    see my work
                </a>
                <span class="text-rosepine-overlay">/</span>
                <a href="#about" class="text-rosepine-subtle hover:text-rosepine-light transition-colors text-sm md:text-base whitespace-nowrap">
                    learn about me
                </a>
            </div>
            <div class="hidden md:flex gap-5 items-center md:ml-auto">
                <a href="https://github.com/ToshoBread" target="_blank" rel="noopener noreferrer" class="text-rosepine-subtle hover:text-rosepine-light transition-colors">
                    <GitHubIcon class="w-6 h-6" />
                </a>
                <a href="https://www.linkedin.com/in/zndionisio/" target="_blank" rel="noopener noreferrer" class="text-rosepine-subtle hover:text-rosepine-light transition-colors">
                    <LinkedInIcon class="w-6 h-6" />
                </a>
            </div>
        </div>
    </div>
</section>
