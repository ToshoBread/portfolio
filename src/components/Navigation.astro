---
import MenuIcon from './icons/MenuIcon.astro';

const navLinks = [
  { href: '#work', label: 'work', section: 'work' },
  { href: '#about', label: 'about', section: 'about' },
  { href: '#contact', label: 'contact', section: 'contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-rosepine-base/80 backdrop-blur-md">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-rosepine-iris focus:text-rosepine-base focus:px-4 focus:py-2 focus:rounded-lg focus:outline-none">
    Skip to main content
  </a>
  <div class="container mx-auto flex items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-medium text-rosepine-foreground hover:text-rosepine-love transition-colors">
      Zion
    </a>
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-section={link.section}
          class="text-sm text-rosepine-subtle hover:text-rosepine-foreground transition-colors nav-link"
        >
          {link.label}
        </a>
      ))}
    </div>
    <button
      id="mobile-menu-btn"
      class="md:hidden text-rosepine-subtle hover:text-rosepine-foreground"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <MenuIcon />
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden bg-rosepine-surface border-t border-rosepine-overlay">
    <div class="container mx-auto px-4 py-4 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-section={link.section}
          class="text-sm text-rosepine-subtle hover:text-rosepine-foreground transition-colors nav-link"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuLinks = menu ? Array.from(menu.querySelectorAll('a')) : [];
  let previousFocus: HTMLElement | null = null;

  function openMenu() {
    menu?.classList.remove('hidden');
    btn?.setAttribute('aria-expanded', 'true');
    previousFocus = document.activeElement as HTMLElement;
    if (menuLinks.length > 0) menuLinks[0].focus();
  }

  function closeMenu() {
    menu?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    previousFocus?.focus();
    previousFocus = null;
  }

  btn?.addEventListener('click', () => {
    const isOpen = menu && !menu.classList.contains('hidden');
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  menu?.addEventListener('keydown', (e) => {
    if (menu.classList.contains('hidden')) return;
    if (e.key === 'Escape') {
      closeMenu();
      return;
    }
    if (e.key === 'Tab') {
      const firstLink = menuLinks[0];
      const lastLink = menuLinks[menuLinks.length - 1];
      if (e.shiftKey && document.activeElement === firstLink) {
        e.preventDefault();
        lastLink.focus();
      } else if (!e.shiftKey && document.activeElement === lastLink) {
        e.preventDefault();
        firstLink.focus();
      }
    }
  });

  menuLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });
</script>
