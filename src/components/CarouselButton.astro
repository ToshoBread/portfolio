---
import CaretLeftIcon from './icons/CaretLeftIcon.astro';
import CaretRightIcon from './icons/CaretRightIcon.astro';

interface Props {
  direction: 'left' | 'right';
  variant: 'card' | 'lightbox';
  [key: string]: any;
}

const { direction, variant, ...rest } = Astro.props;

const Icon = direction === 'left' ? CaretLeftIcon : CaretRightIcon;
const ariaLabel = direction === 'left'
  ? (variant === 'card' ? 'Previous image' : 'Previous')
  : (variant === 'card' ? 'Next image' : 'Next');

const base = 'absolute top-1/2 -translate-y-1/2 flex items-center justify-center rounded-full z-10';

const variantClass = variant === 'card'
  ? `w-7 h-7 ${direction === 'left' ? 'left-2' : 'right-2'} bg-rosepine-base/60 text-rosepine-subtle hover:text-rosepine-light opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity`
  : `w-12 h-12 md:w-14 md:h-14 ${direction === 'left' ? 'left-3 md:left-8' : 'right-3 md:right-8'} bg-rosepine-surface/60 lg:bg-rosepine-surface text-rosepine-light hover:text-rosepine-rose transition-colors`;
---

<button class:list={[base, variantClass]} aria-label={ariaLabel} tabindex={variant === 'card' ? -1 : undefined} {...rest}>
  <Icon />
</button>