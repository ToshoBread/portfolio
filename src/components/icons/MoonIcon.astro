---
interface Props {
  class?: string;
  'data-theme-icon'?: string;
}

const { class: className = 'w-5 h-5', ...rest } = Astro.props;
---

<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" {...rest}>
  <title>Switch to dark mode</title>
  <path stroke-linecap="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
</svg>
