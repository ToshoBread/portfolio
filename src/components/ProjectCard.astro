---
import { Image } from 'astro:assets';
import ExternalLinkIcon from './icons/ExternalLinkIcon.astro';
import GitHubIcon from './icons/GitHubIcon.astro';
import CarouselButton from './CarouselButton.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  repo?: string;
  live?: string;
  images?: ImageMetadata[];
}

const { title, description, tags, repo, live, images = [] } = Astro.props;
const hasImages = images.length > 0;
---

<div tabindex="0" class:list={['group bg-rosepine-surface rounded-2xl overflow-hidden hover:bg-rosepine-overlay focus-within:bg-rosepine-overlay transition-all flex flex-col outline-none', hasImages && 'md:flex-row']}>
  {hasImages && (
    <div class="w-full md:w-2/5 min-h-[200px] md:min-h-0 flex-shrink-0 relative">
      <div
        class="carousel-container relative w-full h-full overflow-hidden rounded-2xl cursor-zoom-in focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rosepine-love focus-visible:ring-offset-2 focus-visible:ring-offset-rosepine-base"
        tabindex="0"
        role="button"
        aria-label={`View ${title} screenshots`}
        data-images={JSON.stringify(images.map(img => img.src))}
        data-title={title}
      >
        {images.map((img, i) => (
          <Image
            src={img}
            alt={`${title} screenshot ${i + 1}`}
            widths={[400, 800]}
            sizes="(max-width: 768px) 100vw, 20vw"
            class:list={[
              'absolute inset-0 w-full h-full object-cover transition-opacity duration-300',
              i === 0 ? 'opacity-100' : 'opacity-0',
            ]}
            data-carousel={`${title}-${i}`}
          />
        ))}
      </div>
      <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10" role="tablist" aria-label={`${title} slides`}>
        {images.map((_, i) => (
          <button
            tabindex="-1"
            role="tab"
            aria-selected={i === 0}
            class:list={[
              'w-2 h-2 rounded-full transition-colors',
              i === 0 ? 'bg-rosepine-foreground' : 'bg-rosepine-subtle/40',
            ]}
            data-dot={`${title}-${i}`}
            aria-label={`Image ${i + 1}`}
          />
        ))}
      </div>
      <CarouselButton direction="left" variant="card" data-prev={title} />
      <CarouselButton direction="right" variant="card" data-next={title} />
    </div>
  )}
  <div class="relative p-8 flex flex-col justify-center flex-1 min-w-0">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-xl font-semibold text-rosepine-foreground font-body">{title}</h3>
      <div class="flex gap-3 flex-shrink-0" data-stop-propagation>
        {live && (
          <a
            href={live}
            target="_blank"
            rel="noopener noreferrer"
            class="text-rosepine-subtle hover:text-rosepine-foreground transition-colors"
          >
            <ExternalLinkIcon />
          </a>
        )}
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-rosepine-subtle hover:text-rosepine-foreground transition-colors"
        >
          <GitHubIcon />
        </a>
      </div>
    </div>
    <div class="project-desc-wrap relative mb-6">
      <p class="project-desc text-rosepine-subtle text-sm leading-relaxed font-body">{description}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs font-mono px-2 py-1 bg-rosepine-base text-rosepine-iris rounded">{tag}</span>
      ))}
    </div>
  </div>
</div>

<script>
  function initCarousels() {
    document.querySelectorAll('[data-stop-propagation]').forEach((el) => {
      el.addEventListener('click', (e) => e.stopPropagation());
    });

    document.querySelectorAll('.carousel-container').forEach((container) => {
      const el = container as HTMLElement;
      const slides = container.querySelectorAll('[data-carousel]');
      if (slides.length === 0) return;

      const prefix = slides[0]?.getAttribute('data-carousel')?.replace(/-\d+$/, '') ?? '';
      let current = 0;

      const dots = document.querySelectorAll(`[data-dot^="${prefix}-"]`);
      const prevBtn = document.querySelector(`[data-prev="${prefix}"]`);
      const nextBtn = document.querySelector(`[data-next="${prefix}"]`);

      function show(index: number) {
        slides.forEach((s, i) => s.classList.toggle('opacity-100', i === index));
        slides.forEach((s, i) => s.classList.toggle('opacity-0', i !== index));
        dots.forEach((d, i) => {
          d.classList.toggle('bg-rosepine-foreground', i === index);
          d.classList.toggle('bg-rosepine-subtle/40', i !== index);
          d.setAttribute('aria-selected', String(i === index));
        });
        current = index;
      }

      function openLightbox() {
        const images = JSON.parse(el.getAttribute('data-images') || '[]');
        const title = el.getAttribute('data-title') || '';
        document.dispatchEvent(
          new CustomEvent('lightbox-open', { detail: { images, title, current } })
        );
      }

      el.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox();
      });

      el.addEventListener('keydown', ((e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          e.stopPropagation();
          openLightbox();
          return;
        }
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          e.stopPropagation();
          show((current - 1 + slides.length) % slides.length);
          return;
        }
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          e.stopPropagation();
          show((current + 1) % slides.length);
          return;
        }
      }) as EventListener);

      prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); show((current - 1 + slides.length) % slides.length); });
      nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); show((current + 1) % slides.length); });
      dots.forEach((dot, i) => dot.addEventListener('click', (e) => { e.stopPropagation(); show(i); }));

      document.addEventListener('lightbox-index-change', ((e: CustomEvent) => {
        if (e.detail.title === prefix) show(e.detail.index);
      }) as EventListener);
    });
  }

  document.addEventListener('DOMContentLoaded', initCarousels);
</script>

<style>
  @media (max-width: 767px) {
    .project-desc-wrap {
      max-height: 4.5rem;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .project-desc-wrap::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 1.5rem;
      background: linear-gradient(transparent, theme('colors.rosepine.surface'));
      transition: opacity 0.3s ease;
    }
    .group:focus-within .project-desc-wrap {
      max-height: 50rem;
    }
    .group:focus-within .project-desc-wrap::after {
      opacity: 0;
    }
  }
</style>
